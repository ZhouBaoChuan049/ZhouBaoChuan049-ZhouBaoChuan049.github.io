---
const stanzas = [
	['Making it run is only the beginning.'],
	['Readable, maintainable, efficient, and secure code', 'is the true destination.'],
	['Every commit is a step toward becoming', 'a better developer.'],
];
---

<aside class="glass-card">
	<blockquote>
		{stanzas.map((stanza) => (
			<p class="quote-stanza">
				{stanza.map((line) => (
					<span>{line}</span>
				))}
			</p>
		))}
	</blockquote>
</aside>

<script define:vars={{ stanzas }}>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const stanzaEls = Array.from(document.querySelectorAll('.glass-card .quote-stanza'));

	const lines = [];
	stanzas.forEach((stanzaText, si) => {
		stanzaText.forEach((text, li) => {
			const el = stanzaEls[si]?.querySelectorAll('span')[li];
			if (el) lines.push({ el, text, stanzaEnd: li === stanzaText.length - 1 });
		});
	});

	if (!reduceMotion && lines.length > 0) {
		lines.forEach((l) => {
			l.el.textContent = '';
		});

		let idx = 0;
		let pos = 0;

		function type() {
			if (idx >= lines.length) {
				lines.forEach((l) => l.el.classList.remove('is-typing'));
				return;
			}

			const line = lines[idx];
			if (pos === 0) line.el.classList.add('is-typing');

			if (pos < line.text.length) {
				line.el.textContent = line.text.slice(0, pos + 1);
				pos += 1;
				window.setTimeout(type, 40);
			} else {
				line.el.classList.remove('is-typing');
				pos = 0;
				idx += 1;
				window.setTimeout(type, line.stanzaEnd ? 420 : 90);
			}
		}

		// 等待玻璃卡片淡入动画开始后再打字
		window.setTimeout(type, 300);
	}
</script>

<style>
	.glass-card {
		width: min(620px, calc(100% - 32px));
		max-width: 620px;
		padding: clamp(24px, 4vw, 32px);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow:
			var(--glass-shadow),
			inset 0 1px 0 rgba(255, 255, 255, 0.14);
		animation: card-in var(--dur-slower) var(--ease-out) 0.2s both;
	}

	.glass-card blockquote {
		margin: 0;
		text-align: center;
	}

	.glass-card .quote-stanza {
		margin: 0;
		font-family: 'Cormorant Garamond', 'Cormorant', 'EB Garamond', 'Playfair Display', Georgia,
			serif;
		font-weight: 400;
		font-size: clamp(0.9375rem, 2.5vw, 1.0625rem);
		line-height: 1.65;
		letter-spacing: 0.05em;
		color: rgba(255, 252, 247, 0.82);
		text-shadow: 0 0 26px rgba(255, 250, 240, 0.14);
	}

	.glass-card .quote-stanza + .quote-stanza {
		margin-top: 0.5em;
	}

	.quote-stanza span {
		display: block;
		min-height: 1.65em;
	}

	.quote-stanza span.is-typing::after {
		content: '';
		display: inline-block;
		width: 1px;
		height: 1em;
		margin-left: 3px;
		vertical-align: -0.12em;
		background: rgba(255, 255, 255, 0.75);
		animation: caret-blink 1s steps(1) infinite;
	}

	@keyframes caret-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@media (min-width: 640px) {
		.glass-card .quote-stanza {
			font-size: clamp(1.0625rem, 2.4vw, 1.1875rem);
		}
	}

	@media (min-width: 1024px) {
		.glass-card .quote-stanza {
			font-size: clamp(1.1875rem, 1.6vw, 1.375rem);
		}
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glass-card {
			animation: none;
		}

		.quote-stanza span.is-typing::after {
			animation: none;
		}
	}
</style>