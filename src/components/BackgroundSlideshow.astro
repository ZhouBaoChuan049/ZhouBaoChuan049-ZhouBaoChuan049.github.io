---
// 背景幻灯片图片。如需替换，仅修改此数组即可。
const slides = [
	'/images/back1.jpg',
	'/images/back2.jpg',
	'/images/back3.jpg',
	'/images/back4.jpg',
	'/images/back5.jpg',
	'/images/back6.jpg',
];
---

<section class="slideshow" data-slideshow aria-hidden="true">
	<div class="slide" data-slide="a"><div class="slide-bg"></div></div>
	<div class="slide" data-slide="b"><div class="slide-bg"></div></div>
	<div class="slide-overlay"></div>
</section>

<div class="slideshow-ui">
	<button class="nav nav--prev" data-prev aria-label="上一张图片" title="上一张">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
	</button>

	<div class="dots" role="group" aria-label="背景图片切换指示器">
		{slides.map((_, i) => (
			<button class="dot" data-dot={i} aria-label={`切换到第 ${i + 1} 张图片`}></button>
		))}
	</div>

	<button class="nav nav--next" data-next aria-label="下一张图片" title="下一张">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
	</button>
</div>

<script define:vars={{ slides }}>
	const layers = Array.from(document.querySelectorAll('[data-slide]'));
	const dots = Array.from(document.querySelectorAll('[data-dot]'));
	const prevBtn = document.querySelector('[data-prev]');
	const nextBtn = document.querySelector('[data-next]');

	const DURATION = 6000;

	let current = 0;
	let activeLayer = 0;
	let timer = null;

	const preloaded = new Set();

	function setBkg(layer, src) {
		layer.querySelector('.slide-bg').style.backgroundImage = `url("${src}")`;
	}

	function preload(src) {
		if (preloaded.has(src)) return;
		preloaded.add(src);
		const img = new Image();
		img.decoding = 'async';
		img.src = src;
	}

	function transitionTo(target) {
		if (target === current) return;
		const incoming = layers[1 - activeLayer];
		setBkg(incoming, slides[target]);
		incoming.classList.add('is-active');
		layers[activeLayer].classList.remove('is-active');
		activeLayer = 1 - activeLayer;
		current = target;
		renderDots();
		preload(slides[(current + 1) % slides.length]);
	}

	function next() {
		transitionTo((current + 1) % slides.length);
	}

	function prev() {
		transitionTo((current - 1 + slides.length) % slides.length);
	}

	function renderDots() {
		dots.forEach((dot, i) => {
			const on = i === current;
			dot.classList.toggle('is-active', on);
			if (on) dot.setAttribute('aria-current', 'true');
			else dot.removeAttribute('aria-current');
		});
	}

	function start() {
		stop();
		timer = window.setInterval(next, DURATION);
	}

	function stop() {
		if (timer !== null) {
			window.clearInterval(timer);
			timer = null;
		}
	}

	// 初始化：第一张立即显示，预加载下一张
	setBkg(layers[0], slides[0]);
	layers[0].classList.add('is-active');
	renderDots();
	preload(slides[1]);
	start();

	nextBtn.addEventListener('click', () => {
		next();
		start();
	});
	prevBtn.addEventListener('click', () => {
		prev();
		start();
	});
	dots.forEach((dot, i) =>
		dot.addEventListener('click', () => {
			transitionTo(i);
			start();
		})
	);

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') {
			next();
			start();
		} else if (e.key === 'ArrowLeft') {
			prev();
			start();
		}
	});

	document.addEventListener('visibilitychange', () => {
		if (document.hidden) stop();
		else start();
	});
</script>

<style>
	.slideshow {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: #0b0d12;
	}

	.slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity var(--fade) var(--ease-in-out);
		will-change: opacity;
	}

	.slide.is-active {
		opacity: 1;
	}

	.slide-bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transform: scale(1);
		transition: transform var(--exposure) linear;
		will-change: transform;
	}

	.slide.is-active .slide-bg {
		transform: scale(1.03);
	}

	.slide-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(120% 90% at 50% 45%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.34) 100%),
			linear-gradient(
				180deg,
				rgba(0, 0, 0, 0.28) 0%,
				rgba(0, 0, 0, 0.05) 42%,
				rgba(0, 0, 0, 0.32) 100%
			);
	}

	.slideshow-ui {
		position: fixed;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	.nav,
	.dots,
	.dot {
		pointer-events: auto;
	}

	.nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		color: var(--c-muted);
		border: 1px solid transparent;
		opacity: 0.55;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.nav:hover {
		opacity: 1;
		color: #fff;
		background: var(--glass-bg);
		border-color: var(--glass-border);
	}

	.nav:active {
		transform: translateY(-50%) scale(0.94);
	}

	.nav svg {
		width: 20px;
		height: 20px;
	}

	.nav--prev {
		left: 20px;
	}

	.nav--next {
		right: 20px;
	}

	.dots {
		position: absolute;
		left: 28px;
		bottom: 28px;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.45);
		opacity: 0.55;
		transition:
			all var(--dur-med) var(--ease-out),
			background var(--dur-med) var(--ease-out);
	}

	.dot:hover {
		opacity: 1;
		background: rgba(255, 255, 255, 0.9);
	}

	.dot.is-active {
		opacity: 1;
		width: 26px;
		background: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition-duration: 0.3s;
		}

		.slide-bg {
			transition: none;
		}

		.slide.is-active .slide-bg {
			transform: none;
		}
	}

	@media (max-width: 640px) {
		.nav--prev {
			left: 10px;
		}

		.nav--next {
			right: 10px;
		}

		.dots {
			left: 16px;
			bottom: 18px;
		}
	}
</style>