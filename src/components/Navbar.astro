---
const name = 'Steve';
const brandSub = 'Steve World';

const links = [
	{ label: 'Home', href: '/', active: true },
	{ label: 'Blog', href: '#blog' },
	{ label: 'Projects', href: '#projects' },
];
---

<header class="navbar" data-navbar>
	<a class="brand" href="/">
		<span class="brand-name">{name}</span>
		<span class="brand-sub">{brandSub}</span>
	</a>

	<button class="menu-toggle" data-menu-toggle aria-label="打开菜单" aria-expanded="false" aria-controls="site-nav">
		<span></span>
		<span></span>
	</button>

	<nav id="site-nav" class="nav-links" aria-label="主要导航">
		<ul>
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						class:list={['nav-link', { 'is-active': link.active }]}
						aria-current={link.active ? 'page' : undefined}
					>
						{link.label}
					</a>
				</li>
			))}
			<li>
				<button class="search-btn" type="button" aria-label="搜索" title="搜索">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="7" />
						<path d="m20 20-3.5-3.5" />
					</svg>
				</button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const header = document.querySelector('[data-navbar]');
	const toggle = document.querySelector('[data-menu-toggle]');
	const nav = document.querySelector('.nav-links');

	toggle?.addEventListener('click', () => {
		const open = header.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(open));
	});

	nav?.querySelectorAll('a').forEach((a) => {
		a.addEventListener('click', () => {
			header.classList.remove('is-open');
			toggle.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.navbar {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px clamp(20px, 5vw, 60px);
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.24), rgba(0, 0, 0, 0));
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 4px;
		line-height: 1;
	}

	.brand-name {
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		font-weight: 600;
		letter-spacing: 0.03em;
		color: #fff;
	}

	.brand-sub {
		font-size: 0.62rem;
		letter-spacing: 0.36em;
		text-transform: uppercase;
		color: var(--c-faint);
	}

	.nav-links ul {
		display: flex;
		align-items: center;
		gap: clamp(20px, 3vw, 40px);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		position: relative;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: rgba(255, 255, 255, 0.86);
		padding: 6px 2px;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform var(--dur-med) var(--ease-out);
	}

	.nav-link:hover,
	.nav-link.is-active {
		opacity: 1;
		color: #fff;
	}

	.nav-link:hover::after,
	.nav-link.is-active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.search-btn {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		color: var(--c-muted);
		opacity: 0.7;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.search-btn svg {
		width: 18px;
		height: 18px;
	}

	.search-btn:hover,
	.search-btn:focus-visible {
		opacity: 1;
		color: #fff;
		background: var(--glass-bg);
		transform: scale(1.08);
	}

	.search-btn:active {
		transform: scale(0.96);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		z-index: 4;
		padding: 8px;
	}

	.menu-toggle span {
		display: block;
		width: 22px;
		height: 1.5px;
		background: #fff;
		transition:
			transform var(--dur-med) var(--ease-out),
			opacity var(--dur-fast) var(--ease-out);
	}

	.navbar.is-open .menu-toggle span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}

	.navbar.is-open .menu-toggle span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	@media (max-width: 768px) {
		.menu-toggle {
			display: flex;
		}

		.nav-links {
			position: fixed;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgba(8, 10, 14, 0.55);
			backdrop-filter: blur(24px);
			-webkit-backdrop-filter: blur(24px);
			opacity: 0;
			pointer-events: none;
			transition: opacity var(--dur-med) var(--ease-out);
		}

		.navbar.is-open .nav-links {
			opacity: 1;
			pointer-events: auto;
		}

		.nav-links ul {
			flex-direction: column;
			align-items: center;
			gap: 28px;
		}

		.nav-link {
			font-size: 1.1rem;
		}

		.search-btn {
			width: 30px;
			height: 30px;
		}

		.search-btn svg {
			width: 16px;
			height: 16px;
		}
	}
</style>