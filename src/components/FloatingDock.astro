---
// 底部悬浮玻璃 Dock 的个人链接
const items = [
	{ label: 'GitHub', href: 'https://github.com' },
	{ label: 'Blog', href: '#blog' },
	{ label: 'Email', href: 'mailto:hello@example.com' },
	{ label: 'About', href: '#about' },
];
---

<nav class="dock" aria-label="个人链接">
	<a class="dock-btn" href="https://github.com" aria-label="GitHub" title="GitHub">
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.26 5.7.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
		</svg>
	</a>

	<a class="dock-btn" href="#blog" aria-label="Blog" title="Blog">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 20h9" />
			<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
		</svg>
	</a>

	<a class="dock-btn" href="mailto:hello@example.com" aria-label="Email" title="Email">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3 7 9 6 9-6" />
		</svg>
	</a>

	<a class="dock-btn" href="#about" aria-label="About" title="About">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="8" r="4" />
			<path d="M4 21c0-3.9 3.6-6 8-6s8 2.1 8 6" />
		</svg>
	</a>
</nav>

<style>
	.dock {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		align-self: center;
		border-radius: 999px;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		box-shadow:
			0 16px 40px rgba(0, 0, 0, 0.28),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
	}

	.dock-btn {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		color: var(--c-muted);
		opacity: 0.65;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.dock-btn svg {
		width: 20px;
		height: 20px;
	}

	.dock-btn:hover,
	.dock-btn:focus-visible {
		opacity: 1;
		color: #fff;
		background: var(--glass-bg-strong);
		transform: translateY(-4px) scale(1.05);
	}

	.dock-btn:active {
		transform: translateY(-2px) scale(0.98);
	}

	@media (max-width: 640px) {
		.dock-btn {
			width: 38px;
			height: 38px;
		}

		.dock-btn svg {
			width: 18px;
			height: 18px;
		}
	}
</style>