---
const name = 'Steve';
const tagline = 'Creative Developer & Writer';
---

<section class="hero">
	<h1 class="hero-name">{name}</h1>
	<p class="hero-tagline">{tagline}</p>
</section>

<style>
	.hero {
		text-align: center;
		animation: hero-in var(--dur-slower) var(--ease-out) both;
	}

	.hero-name {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(3.5rem, 13vw, 11rem);
		line-height: 1;
		letter-spacing: 0.01em;
		color: #fff;
		text-shadow: 0 6px 40px rgba(0, 0, 0, 0.35);
	}

	.hero-tagline {
		margin: clamp(12px, 2vh, 22px) 0 0;
		font-size: clamp(0.8rem, 1.6vw, 1rem);
		font-weight: 400;
		letter-spacing: 0.38em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	@keyframes hero-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero {
			animation: none;
		}
	}
</style>